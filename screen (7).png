<!DOCTYPE html>

<html class="light" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>RHMS - Admin Dashboard</title>
<!-- Material Symbols -->
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<!-- Google Fonts: Inter & JetBrains Mono -->
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;family=JetBrains+Mono:wght@400&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<!-- Tailwind CSS -->
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<!-- Tailwind Config -->
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "on-secondary-container": "#006e6e",
                        "on-primary-container": "#bcceff",
                        "surface-container": "#eceef0",
                        "outline-variant": "#c3c6d5",
                        "secondary": "#006a6a",
                        "surface-variant": "#e0e3e5",
                        "primary-fixed-dim": "#b0c6ff",
                        "on-primary-fixed-variant": "#00419c",
                        "inverse-on-surface": "#eff1f3",
                        "on-tertiary-container": "#c3cee6",
                        "on-background": "#191c1e",
                        "surface-container-low": "#f2f4f6",
                        "primary": "#003c90",
                        "surface-bright": "#f7f9fb",
                        "on-error": "#ffffff",
                        "tertiary-container": "#4d586c",
                        "tertiary-fixed-dim": "#bcc7de",
                        "on-surface-variant": "#434653",
                        "inverse-surface": "#2d3133",
                        "surface-dim": "#d8dadc",
                        "surface-container-highest": "#e0e3e5",
                        "background": "#f7f9fb",
                        "on-primary": "#ffffff",
                        "on-secondary-fixed-variant": "#004f4f",
                        "on-tertiary-fixed-variant": "#3c475a",
                        "error": "#ba1a1a",
                        "secondary-container": "#90efef",
                        "on-primary-fixed": "#001945",
                        "on-tertiary": "#ffffff",
                        "surface-tint": "#1d59c1",
                        "inverse-primary": "#b0c6ff",
                        "primary-container": "#0f52ba",
                        "primary-fixed": "#d9e2ff",
                        "surface-container-high": "#e6e8ea",
                        "on-secondary-fixed": "#002020",
                        "on-secondary": "#ffffff",
                        "secondary-fixed": "#93f2f2",
                        "surface-container-lowest": "#ffffff",
                        "tertiary-fixed": "#d8e3fb",
                        "error-container": "#ffdad6",
                        "on-surface": "#191c1e",
                        "secondary-fixed-dim": "#76d6d5",
                        "tertiary": "#364154",
                        "on-error-container": "#93000a",
                        "outline": "#737784",
                        "on-tertiary-fixed": "#111c2d",
                        "surface": "#f7f9fb"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.125rem",
                        "lg": "0.25rem",
                        "xl": "0.5rem",
                        "full": "0.75rem"
                    },
                    "spacing": {
                        "gutter": "20px",
                        "sidebar-width": "260px",
                        "xl": "32px",
                        "xs": "4px",
                        "container-max": "1440px",
                        "md": "16px",
                        "sm": "8px",
                        "lg": "24px",
                        "base": "4px"
                    },
                    "fontFamily": {
                        "body-md": ["Inter"],
                        "data-mono": ["JetBrains Mono"],
                        "headline-sm": ["Inter"],
                        "body-lg": ["Inter"],
                        "headline-lg-mobile": ["Inter"],
                        "headline-lg": ["Inter"],
                        "headline-md": ["Inter"],
                        "label-sm": ["Inter"],
                        "label-md": ["Inter"]
                    },
                    "fontSize": {
                        "body-md": ["14px", { "lineHeight": "20px", "fontWeight": "400" }],
                        "data-mono": ["13px", { "lineHeight": "18px", "fontWeight": "400" }],
                        "headline-sm": ["20px", { "lineHeight": "28px", "fontWeight": "600" }],
                        "body-lg": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                        "headline-lg-mobile": ["24px", { "lineHeight": "32px", "fontWeight": "700" }],
                        "headline-lg": ["32px", { "lineHeight": "40px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                        "headline-md": ["24px", { "lineHeight": "32px", "fontWeight": "600" }],
                        "label-sm": ["12px", { "lineHeight": "16px", "fontWeight": "500" }],
                        "label-md": ["13px", { "lineHeight": "18px", "letterSpacing": "0.05em", "fontWeight": "600" }]
                    }
                }
            }
        }
    </script>
<style>
        /* Custom Styles for Charts & Tables */
        .chart-area {
            background-image: linear-gradient(to right, #e0e3e5 1px, transparent 1px), linear-gradient(to bottom, #e0e3e5 1px, transparent 1px);
            background-size: 40px 40px;
        }
    </style>
</head>
<body class="bg-background text-on-background font-body-md min-h-screen antialiased flex">
<!-- SideNavBar (Shared Component) -->
<nav class="hidden md:flex flex-col h-screen fixed left-0 top-0 z-40 w-[260px] bg-[#1E293B] border-r border-outline-variant transition-all duration-200 ease-in-out text-white">
<!-- Header -->
<div class="px-6 py-6 border-b border-surface-variant/20 mb-4">
<div class="flex items-center gap-3">
<div class="w-10 h-10 rounded bg-primary-container flex items-center justify-center shrink-0">
<span class="material-symbols-outlined text-on-primary-container font-bold" style="font-variation-settings: 'FILL' 1;">medical_services</span>
</div>
<div>
<h1 class="font-headline-md text-headline-md font-bold text-white tracking-tight">RHMS</h1>
<p class="font-label-sm text-label-sm text-surface-variant/70">Clinical Portal</p>
</div>
</div>
</div>
<!-- Main Tabs -->
<div class="flex-1 overflow-y-auto px-2 space-y-1">
<!-- Active Tab: Dashboard -->
<a class="flex items-center gap-3 px-4 py-3 border-l-4 border-secondary-fixed bg-secondary-container/10 text-secondary-fixed font-label-md text-label-md rounded-r-DEFAULT" href="#">
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">dashboard</span>
                Dashboard
            </a>
<a class="flex items-center gap-3 px-4 py-3 text-surface-variant/70 hover:text-white hover:bg-white/5 transition-colors font-label-md text-label-md rounded-r-DEFAULT border-l-4 border-transparent" href="#">
<span class="material-symbols-outlined">cloud_download</span>
                Patient Management
            </a>
<a class="flex items-center gap-3 px-4 py-3 text-surface-variant/70 hover:text-white hover:bg-white/5 transition-colors font-label-md text-label-md rounded-r-DEFAULT border-l-4 border-transparent" href="#">
<span class="material-symbols-outlined">assessment</span>
                Assessment
            </a>
<a class="flex items-center gap-3 px-4 py-3 text-surface-variant/70 hover:text-white hover:bg-white/5 transition-colors font-label-md text-label-md rounded-r-DEFAULT border-l-4 border-transparent" href="#">
<span class="material-symbols-outlined">edit_calendar</span>
                Treatment Plans
            </a>
<a class="flex items-center gap-3 px-4 py-3 text-surface-variant/70 hover:text-white hover:bg-white/5 transition-colors font-label-md text-label-md rounded-r-DEFAULT border-l-4 border-transparent" href="#">
<span class="material-symbols-outlined">analytics</span>
                Reporting
            </a>
</div>
<!-- CTA -->
<div class="px-4 py-4">
<button class="w-full flex items-center justify-center gap-2 bg-secondary text-on-secondary px-4 py-2.5 rounded-md font-label-md text-label-md hover:bg-secondary/90 transition-colors shadow-sm">
<span class="material-symbols-outlined text-[18px]">add</span>
                New Admission
            </button>
</div>
<!-- Footer Tabs -->
<div class="px-2 pb-6 pt-4 border-t border-surface-variant/20 space-y-1">
<a class="flex items-center gap-3 px-4 py-3 text-surface-variant/70 hover:text-white hover:bg-white/5 transition-colors font-label-md text-label-md rounded-md" href="#">
<span class="material-symbols-outlined">settings</span>
                Settings
            </a>
<a class="flex items-center gap-3 px-4 py-3 text-surface-variant/70 hover:text-white hover:bg-white/5 transition-colors font-label-md text-label-md rounded-md" href="#">
<span class="material-symbols-outlined">help</span>
                Support
            </a>
</div>
</nav>
<!-- Main Content Area -->
<main class="flex-1 md:ml-[260px] min-h-screen flex flex-col w-full relative">
<!-- TopNavBar (Shared Component) -->
<header class="flex justify-between items-center h-16 px-gutter w-full bg-surface border-b border-outline-variant z-30 sticky top-0">
<!-- Mobile Menu Button (hidden on desktop) -->
<button class="md:hidden p-2 text-on-surface-variant hover:text-on-surface hover:bg-surface-container-low transition-colors rounded-full">
<span class="material-symbols-outlined">menu</span>
</button>
<!-- Product Name / Title -->
<div class="flex items-center gap-4">
<h2 class="font-headline-sm text-headline-sm font-bold text-primary hidden md:block">Rehab Management</h2>
<h2 class="font-headline-sm text-headline-sm font-bold text-primary md:hidden">Dashboard</h2>
</div>
<!-- Right Actions -->
<div class="flex items-center gap-2">
<button class="p-2 text-on-surface-variant hover:text-on-surface hover:bg-surface-container-low transition-colors rounded-full relative scale-95 active:opacity-80 transition-transform">
<span class="material-symbols-outlined">notifications</span>
<span class="absolute top-1.5 right-1.5 w-2 h-2 bg-error rounded-full"></span>
</button>
<button class="p-2 text-on-surface-variant hover:text-on-surface hover:bg-surface-container-low transition-colors rounded-full scale-95 active:opacity-80 transition-transform">
<span class="material-symbols-outlined">history</span>
</button>
<div class="h-8 w-px bg-outline-variant mx-2"></div>
<button class="flex items-center gap-2 hover:bg-surface-container-low transition-colors p-1 pr-3 rounded-full scale-95 active:opacity-80 transition-transform group">
<div class="w-8 h-8 rounded-full overflow-hidden border border-outline-variant group-hover:border-primary transition-colors shrink-0">
<img alt="Current user profile picture" class="w-full h-full object-cover" data-alt="Professional headshot of a clinical administrator in a bright, modern hospital setting. Neutral background, soft lighting, sharp focus. Cinematic corporate style, highly detailed." src="https://lh3.googleusercontent.com/aida-public/AB6AXuDtH0rnBQjXUaoTu0irsk3Yft1RfroZfVO9Vvow4f4Y1Z7_ExlZf6yN-qRbjjcODZRqIl6DT2OU_zEq77ePY9opUvKyqhkGFCyuSuB3dBsUfGc8LH1iJPCgbszhGdn3lmvZxsdo_uTRrF4EXNn9gGw9xahNQdNmy5hwiR08JXipCI8AT2kXqYpvQoiuTb1uiGq1LeiF1uAaGP-cJgpYu8cGxNSWIr4ZVCjtUmfRfCBRUHShGXp0P0EQLw"/>
</div>
<span class="font-label-md text-label-md text-primary font-bold hidden sm:block">Profile</span>
</button>
</div>
</header>
<!-- Canvas -->
<div class="p-gutter max-w-container-max mx-auto w-full space-y-lg flex-1 pb-16 md:pb-gutter">
<!-- Page Header -->
<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-2">
<div>
<h2 class="font-headline-lg text-headline-lg font-bold text-on-surface">Overview</h2>
<p class="font-body-md text-body-md text-on-surface-variant mt-1">Real-time facility metrics and therapy schedules.</p>
</div>
<div class="flex gap-2">
<button class="px-4 py-2 border border-outline-variant rounded-md font-label-md text-label-md text-on-surface hover:bg-surface-container-low transition-colors flex items-center gap-2">
<span class="material-symbols-outlined text-[18px]">calendar_today</span>
                        Today, Oct 24
                    </button>
</div>
</div>
<!-- Stats Grid -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-md">
<!-- Stat Card 1 -->
<div class="bg-white border border-surface-variant p-4 rounded-lg flex flex-col gap-3 hover:bg-surface-container-lowest transition-colors relative overflow-hidden group">
<div class="absolute top-0 right-0 w-16 h-16 bg-primary-container/10 rounded-bl-full -mr-4 -mt-4 transition-transform group-hover:scale-110"></div>
<div class="flex justify-between items-start">
<span class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Total Patients</span>
<span class="material-symbols-outlined text-primary">groups</span>
</div>
<div class="flex items-baseline gap-2">
<span class="font-headline-lg text-headline-lg font-bold text-on-surface">142</span>
<span class="font-label-sm text-label-sm text-secondary bg-secondary-container/30 px-1.5 py-0.5 rounded flex items-center gap-0.5">
<span class="material-symbols-outlined text-[12px]">trending_up</span> +4%
                        </span>
</div>
</div>
<!-- Stat Card 2 -->
<div class="bg-white border border-surface-variant p-4 rounded-lg flex flex-col gap-3 hover:bg-surface-container-lowest transition-colors relative overflow-hidden group">
<div class="absolute top-0 right-0 w-16 h-16 bg-secondary-container/10 rounded-bl-full -mr-4 -mt-4 transition-transform group-hover:scale-110"></div>
<div class="flex justify-between items-start">
<span class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Active Therapies</span>
<span class="material-symbols-outlined text-secondary">vital_signs</span>
</div>
<div class="flex items-baseline gap-2">
<span class="font-headline-lg text-headline-lg font-bold text-on-surface">38</span>
<span class="font-label-sm text-label-sm text-on-surface-variant">sessions now</span>
</div>
</div>
<!-- Stat Card 3 -->
<div class="bg-white border border-surface-variant p-4 rounded-lg flex flex-col gap-3 hover:bg-surface-container-lowest transition-colors relative overflow-hidden group">
<div class="absolute top-0 right-0 w-16 h-16 bg-error-container/10 rounded-bl-full -mr-4 -mt-4 transition-transform group-hover:scale-110"></div>
<div class="flex justify-between items-start">
<span class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Bed Occupancy</span>
<span class="material-symbols-outlined text-error">bed</span>
</div>
<div class="flex items-baseline gap-2">
<span class="font-headline-lg text-headline-lg font-bold text-on-surface">86%</span>
<span class="font-label-sm text-label-sm text-error bg-error-container/30 px-1.5 py-0.5 rounded flex items-center gap-0.5">
<span class="material-symbols-outlined text-[12px]">priority_high</span> Near Capacity
                        </span>
</div>
</div>
<!-- Stat Card 4 -->
<div class="bg-white border border-surface-variant p-4 rounded-lg flex flex-col gap-3 hover:bg-surface-container-lowest transition-colors relative overflow-hidden group">
<div class="absolute top-0 right-0 w-16 h-16 bg-tertiary-container/10 rounded-bl-full -mr-4 -mt-4 transition-transform group-hover:scale-110"></div>
<div class="flex justify-between items-start">
<span class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Appts Today</span>
<span class="material-symbols-outlined text-tertiary">event_available</span>
</div>
<div class="flex items-baseline gap-2">
<span class="font-headline-lg text-headline-lg font-bold text-on-surface">124</span>
<span class="font-label-sm text-label-sm text-secondary bg-secondary-container/30 px-1.5 py-0.5 rounded flex items-center gap-0.5">
                            48 remaining
                        </span>
</div>
</div>
</div>
<!-- Charts Section (Bento Layout) -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-md">
<!-- Line Chart: Recovery Progress -->
<div class="lg:col-span-2 bg-white border border-surface-variant rounded-lg p-6 flex flex-col">
<div class="flex justify-between items-center mb-6">
<div>
<h3 class="font-headline-md text-headline-md font-semibold text-on-surface">Facility Recovery Progress</h3>
<p class="font-body-md text-body-md text-on-surface-variant">Aggregate FIM scores vs. Target benchmark</p>
</div>
<button class="p-1.5 text-on-surface-variant hover:bg-surface-container-low rounded-md transition-colors">
<span class="material-symbols-outlined">more_vert</span>
</button>
</div>
<!-- Faux Chart Container -->
<div class="flex-1 min-h-[240px] relative chart-area rounded-md border border-outline-variant/30 flex items-end px-4 pb-8 pt-4">
<!-- Y-Axis Labels -->
<div class="absolute left-2 top-0 bottom-8 flex flex-col justify-between font-data-mono text-data-mono text-on-surface-variant/60 py-4">
<span>100</span>
<span>75</span>
<span>50</span>
<span>25</span>
<span>0</span>
</div>
<!-- Chart Lines (CSS visualization) -->
<div class="w-full h-full relative ml-8 border-b border-l border-outline-variant/50">
<!-- Target Benchmark Line (Dashed) -->
<svg class="absolute inset-0 w-full h-full" preserveaspectratio="none" viewbox="0 0 100 100">
<polyline fill="none" points="0,70 20,65 40,55 60,40 80,30 100,20" stroke="#003c90" stroke-dasharray="4 4" stroke-width="2" vector-effect="non-scaling-stroke"></polyline>
</svg>
<!-- Actual Recovery Line (Teal Area) -->
<svg class="absolute inset-0 w-full h-full" preserveaspectratio="none" viewbox="0 0 100 100">
<defs>
<lineargradient id="tealGrad" x1="0" x2="0" y1="0" y2="1">
<stop offset="0%" stop-color="#006a6a" stop-opacity="0.2"></stop>
<stop offset="100%" stop-color="#006a6a" stop-opacity="0"></stop>
</lineargradient>
</defs>
<polyline fill="none" points="0,80 20,75 40,60 60,45 80,35 100,25" stroke="#006a6a" stroke-linecap="round" stroke-linejoin="round" stroke-width="3" vector-effect="non-scaling-stroke"></polyline>
<polygon fill="url(#tealGrad)" opacity="0.6" points="0,100 0,80 20,75 40,60 60,45 80,35 100,25 100,100"></polygon>
</svg>
</div>
<!-- X-Axis Labels -->
<div class="absolute bottom-1 left-12 right-4 flex justify-between font-data-mono text-data-mono text-on-surface-variant/60">
<span>Week 1</span>
<span>Week 2</span>
<span>Week 3</span>
<span>Week 4</span>
<span>Week 5</span>
</div>
</div>
<div class="flex gap-6 mt-4 justify-center font-label-sm text-label-sm">
<div class="flex items-center gap-2">
<div class="w-3 h-3 rounded-full bg-secondary"></div>
<span class="text-on-surface">Actual FIM Avg</span>
</div>
<div class="flex items-center gap-2">
<div class="w-3 h-3 rounded-full border-2 border-primary border-dashed"></div>
<span class="text-on-surface-variant">Target Benchmark</span>
</div>
</div>
</div>
<!-- Bar Chart: Therapy Distribution -->
<div class="bg-white border border-surface-variant rounded-lg p-6 flex flex-col">
<h3 class="font-headline-md text-headline-md font-semibold text-on-surface mb-1">Therapy Distribution</h3>
<p class="font-body-md text-body-md text-on-surface-variant mb-6">Current active sessions</p>
<div class="flex-1 flex flex-col justify-end gap-4 pb-2">
<!-- Bar Item -->
<div class="space-y-1">
<div class="flex justify-between font-label-sm text-label-sm">
<span class="text-on-surface font-medium">Physical Therapy</span>
<span class="text-on-surface-variant font-data-mono">45%</span>
</div>
<div class="h-2 w-full bg-surface-container-high rounded-full overflow-hidden">
<div class="h-full bg-primary" style="width: 45%;"></div>
</div>
</div>
<!-- Bar Item -->
<div class="space-y-1">
<div class="flex justify-between font-label-sm text-label-sm">
<span class="text-on-surface font-medium">Occupational</span>
<span class="text-on-surface-variant font-data-mono">30%</span>
</div>
<div class="h-2 w-full bg-surface-container-high rounded-full overflow-hidden">
<div class="h-full bg-secondary" style="width: 30%;"></div>
</div>
</div>
<!-- Bar Item -->
<div class="space-y-1">
<div class="flex justify-between font-label-sm text-label-sm">
<span class="text-on-surface font-medium">Speech Therapy</span>
<span class="text-on-surface-variant font-data-mono">15%</span>
</div>
<div class="h-2 w-full bg-surface-container-high rounded-full overflow-hidden">
<div class="h-full bg-tertiary" style="width: 15%;"></div>
</div>
</div>
<!-- Bar Item -->
<div class="space-y-1">
<div class="flex justify-between font-label-sm text-label-sm">
<span class="text-on-surface font-medium">Cognitive</span>
<span class="text-on-surface-variant font-data-mono">10%</span>
</div>
<div class="h-2 w-full bg-surface-container-high rounded-full overflow-hidden">
<div class="h-full bg-on-tertiary-fixed-variant" style="width: 10%;"></div>
</div>
</div>
</div>
</div>
</div>
<!-- Lists Section -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-md">
<!-- Table: Recent Admissions -->
<div class="bg-white border border-surface-variant rounded-lg flex flex-col overflow-hidden">
<div class="p-4 border-b border-outline-variant/30 flex justify-between items-center bg-surface-bright">
<h3 class="font-headline-sm text-headline-sm font-semibold text-on-surface">Recent Admissions</h3>
<a class="font-label-sm text-label-sm text-primary hover:underline" href="#">View All</a>
</div>
<div class="overflow-x-auto">
<table class="w-full text-left border-collapse">
<thead>
<tr class="border-b border-outline-variant/50 bg-surface-bright font-label-md text-label-md text-on-surface-variant">
<th class="py-3 px-4 font-medium uppercase tracking-wider">Patient Name</th>
<th class="py-3 px-4 font-medium uppercase tracking-wider">Diagnosis</th>
<th class="py-3 px-4 font-medium uppercase tracking-wider text-right">Status</th>
</tr>
</thead>
<tbody class="font-body-md text-body-md">
<tr class="border-b border-outline-variant/30 hover:bg-surface-container-lowest transition-colors h-[48px]">
<td class="py-2 px-4 font-medium text-on-surface">Eleanor Vance</td>
<td class="py-2 px-4 text-on-surface-variant">Post-Op Hip Replace.</td>
<td class="py-2 px-4 text-right">
<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-secondary-container/20 text-secondary">Inpatient</span>
</td>
</tr>
<tr class="border-b border-outline-variant/30 hover:bg-surface-container-lowest transition-colors h-[48px]">
<td class="py-2 px-4 font-medium text-on-surface">Marcus Thorne</td>
<td class="py-2 px-4 text-on-surface-variant">Stroke (Ischemic)</td>
<td class="py-2 px-4 text-right">
<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-error-container/20 text-error">Critical Rehab</span>
</td>
</tr>
<tr class="border-b border-outline-variant/30 hover:bg-surface-container-lowest transition-colors h-[48px]">
<td class="py-2 px-4 font-medium text-on-surface">Sarah Jenkins</td>
<td class="py-2 px-4 text-on-surface-variant">Traumatic Brain Inj.</td>
<td class="py-2 px-4 text-right">
<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-secondary-container/20 text-secondary">Inpatient</span>
</td>
</tr>
<tr class="hover:bg-surface-container-lowest transition-colors h-[48px]">
